{
  "name": "analise-curricular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "retention:run": "tsx scripts/run-retention.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs && prisma generate",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "vercel-build": "prisma migrate deploy && tsx prisma/seed.ts && prisma generate && next build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
