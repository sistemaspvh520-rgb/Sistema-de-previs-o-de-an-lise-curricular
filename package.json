    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "file-type": "^22.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.20.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
