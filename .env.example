# ---------------------------------------------------------------
# Banco de dados (PostgreSQL) — docker compose up -d db
# ---------------------------------------------------------------
DATABASE_URL="postgresql://analise:analise_dev_password@localhost:5432/analise_curricular?schema=public"

# ---------------------------------------------------------------
# Auth.js — gere com: openssl rand -base64 32
# ---------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Chave mestra para criptografar segredos (AES-256-GCM).
# 32 bytes em base64 — gere com: openssl rand -base64 32
# NUNCA commitar. Em produção usar Secret Manager/KMS.
# ---------------------------------------------------------------
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="1"

# ---------------------------------------------------------------
# Armazenamento local dos PDFs (fora de public/)
# ---------------------------------------------------------------
STORAGE_DIR="./storage"

# ---------------------------------------------------------------
# Rotina de retenção (GET /api/cron/retention com header Authorization: Bearer <CRON_SECRET>)
# ---------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------
# Usuário administrador inicial (usado apenas pelo seed)
# ---------------------------------------------------------------
ADMIN_EMAIL="admin@cruzeirodosul.local"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="troque-esta-senha-123"

# A API Key da OpenAI NÃO fica aqui: é cadastrada pelo painel (Configurações → OpenAI)
# e armazenada criptografada no banco.
