# ---------------------------------------------------------------
# Banco de dados (PostgreSQL) — docker compose up -d db
# ---------------------------------------------------------------
DATABASE_URL="postgresql://analise:analise_dev_password@localhost:5432/analise_curricular?schema=public"

# ---------------------------------------------------------------
# Auth.js — gere com: openssl rand -base64 32
# ---------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Chave mestra para criptografar segredos (AES-256-GCM).
# 32 bytes em base64 — gere com: openssl rand -base64 32
# NUNCA commitar. Em produção usar Secret Manager/KMS.
# ---------------------------------------------------------------
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="1"

# ---------------------------------------------------------------
# Conexão direta (sem pooler) usada por `prisma migrate deploy` e pelo seed. Opcional em dev.
# ---------------------------------------------------------------
# DIRECT_URL=postgresql://analise:analise@localhost:5432/analise_curricular?schema=public

# ---------------------------------------------------------------
# Armazenamento dos PDFs: `local` (STORAGE_DIR, fora de public/) ou `supabase` (bucket privado)
# ---------------------------------------------------------------
STORAGE_DRIVER=local
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=documents
STORAGE_DIR="./storage"

# ---------------------------------------------------------------
# Rotina de retenção (GET /api/cron/retention com header Authorization: Bearer <CRON_SECRET>)
# ---------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------
# Usuário administrador inicial (usado apenas pelo seed)
# ---------------------------------------------------------------
ADMIN_EMAIL="seu.nome@cruzeirodosul.edu.br"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="troque-esta-senha-123"

# A API Key da OpenAI NÃO fica aqui: é cadastrada pelo painel (Configurações → OpenAI)
# e armazenada criptografada no banco.

# ---------------------------------------------------------------
# Produção (Vercel + Supabase) — ver docs/DEPLOY.md
# ---------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.<ref>:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."        # chave SECRETA (server-only); nunca NEXT_PUBLIC_
# SUPABASE_STORAGE_BUCKET="documents"

# ---------------------------------------------------------------
# E-mail transacional (convites, redefinição de senha) — Gmail/Google Workspace com senha de app
# 1) Ative a verificação em 2 etapas na conta Google; 2) crie uma "Senha de app" (myaccount.google.com/apppasswords)
# ---------------------------------------------------------------
EMAIL_USER="cruzeirogpt@gmail.com"
EMAIL_APP_PASSWORD=""
EMAIL_FROM="Análise Curricular · Cruzeiro do Sul Virtual <cruzeirogpt@gmail.com>"
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="465"
APP_URL="http://localhost:3000"
